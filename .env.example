# ═══════════════════════════════════════════════════════════
# 招生话务CRM系统 - 环境变量配置
# 复制此文件为 .env 并填入实际值
# ═══════════════════════════════════════════════════════════

# ── 数据库 ──────────────────────────────────────────────
# 留空 = 本地 SQLite（开发/小规模）
# 填 PostgreSQL 连接串 = PostgreSQL（生产推荐）
DATABASE_URL=
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/crm_recruitment

# 仅 SQLite 模式：数据库文件路径
# DATABASE_PATH=crm.db

# ── 安全 ────────────────────────────────────────────────
# 必须设置！生成: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ── AI 分析 ─────────────────────────────────────────────
DEEPSEEK_API_KEY=

# ── CORS ────────────────────────────────────────────────
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── 预置账号（初始化时使用） ────────────────────────────
# SEED_PRESET_USERS=1
# INIT_ADMIN_USERNAME=admin
# INIT_ADMIN_PASSWORD=
# INIT_AGENT_USERNAME=agent
# INIT_AGENT_PASSWORD=
