# ═══════════════════════════════════════════════════════════
# 招生话务CRM系统 - 环境变量配置
# 复制此文件为 .env 并填入实际值
# ═══════════════════════════════════════════════════════════

# ── 数据库 ──────────────────────────────────────────────
# 系统只支持 SQLite。通常留空，用下面的 DATABASE_PATH 指定文件即可
DATABASE_URL=

# 数据库文件路径
# DATABASE_PATH=crm.db

# ── 安全 ────────────────────────────────────────────────
# 必须设置！生成: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ── 运行环境 ────────────────────────────────────────────
# 生产填 production：此时必须设置 CORS_ORIGINS，默认信任代理头
# APP_ENV=production
# 不要设置 EXPECTED_ALEMBIC_REVISION，期望版本由代码决定

# ── CORS ────────────────────────────────────────────────
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Cookie / 代理 ───────────────────────────────────────
# 本地 HTTP 调试用 0；只通过 HTTPS 域名访问时设为 1
COOKIE_SECURE=0
# 通过 Cloudflare Tunnel 时设为 1，用 CF-Connecting-IP 做登录限流和审计
TRUST_PROXY_HEADERS=1

# ── 预置账号（初始化时使用） ────────────────────────────
# SEED_PRESET_USERS=1
# INIT_ADMIN_USERNAME=admin
# INIT_ADMIN_PASSWORD=
# INIT_AGENT_USERNAME=agent
# INIT_AGENT_PASSWORD=
